{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "nodenext",
    "types": ["node"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/page/*.js",
    "scripts/page/*.d.ts",
    "tests/*.mjs"
  ]
}
